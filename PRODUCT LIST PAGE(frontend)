import { useEffect, useState } from "react";
import api from "../services/api";

export default function Products() {

  const [products, setProducts] = useState([]);

  useEffect(() => {
    api.get("/products").then(res => setProducts(res.data));
  }, []);

  return (
    <div className="p-4">
      <h2>All Products</h2>

      {products.map(p => (
        <div key={p.id}>
          {p.name} - ${p.price}
        </div>
      ))}
    </div>
  );
}
