const bkash = require("../services/bkashService");

exports.payWithBkash = async (req, res) => {

  const orderId = req.body.orderId;

  db.query("SELECT * FROM orders WHERE id=?", [orderId], async (err, result) => {

    const order = result[0];

    const payment = await bkash.processBkashPayment(order);

    db.query(
      "INSERT INTO payments (order_id, amount, status, method, transaction_id) VALUES (?, ?, ?, 'BKASH', ?)",
      [orderId, order.total, payment.status, payment.transactionId]
    );

    db.query(
      "UPDATE orders SET status='PAID' WHERE id=?",
      [orderId]
    );

    res.json({ msg: "Payment successful via bKash" });
  });
};
