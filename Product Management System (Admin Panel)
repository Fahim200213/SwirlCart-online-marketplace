const role = require("../middleware/roleMiddleware");

// admin only
router.get("/", auth, role("admin"), getUsers);
router.delete("/:id", auth, role("admin"), deleteUser);
router.put("/:id", auth, role("admin"), updateRole);

module.exports = router;

