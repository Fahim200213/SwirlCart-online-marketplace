1. DATABASE DESIGN
--- ADDRESSES TABLE---
CREATE TABLE addresses (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    full_name VARCHAR(100),
    phone VARCHAR(20),
    address_line VARCHAR(255),
    city VARCHAR(100),
    postal_code VARCHAR(20),
    country VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);
--- SHIPMENTS TABLE---
CREATE TABLE shipments (
    id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT,
    address_id INT,
    tracking_number VARCHAR(100),
    carrier VARCHAR(50),
    status ENUM('PROCESSING','SHIPPED','IN_TRANSIT','DELIVERED') DEFAULT 'PROCESSING',
    shipping_cost DECIMAL(10,2),
    estimated_delivery DATE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (order_id) REFERENCES orders(id),
    FOREIGN KEY (address_id) REFERENCES addresses(id)
);

2. SHIPPING COST SERVICE
services/shippingService.js
// simple logic (can be upgraded later)
exports.calculateShipping = (total, city) => {

  let cost = 50; // base cost

  if (total > 1000) cost = 0; // free delivery

  if (city !== "Dhaka") cost += 30;

  return cost;
};
 3. SHIPPING CONTROLLER
controllers/shippingController.js
const db = require("../db");
const shippingService = require("../services/shippingService");


//  ADD ADDRESS
exports.addAddress = (req, res) => {
  const userId = req.user.id;
  const { full_name, phone, address_line, city, postal_code, country } = req.body;

  const sql = `
    INSERT INTO addresses (user_id, full_name, phone, address_line, city, postal_code, country)
    VALUES (?, ?, ?, ?, ?, ?, ?)
  `;

  db.query(sql, [userId, full_name, phone, address_line, city, postal_code, country],
    () => res.json({ msg: "Address added" })
  );
};



//  GET USER ADDRESSES
exports.getAddresses = (req, res) => {
  db.query(
    "SELECT * FROM addresses WHERE user_id=?",
    [req.user.id],
    (err, results) => res.json(results)
  );
};



//  CREATE SHIPMENT (AFTER ORDER)
exports.createShipment = (req, res) => {

  const { orderId, addressId } = req.body;

  // get order total
  db.query("SELECT total FROM orders WHERE id=?", [orderId], (err, orderRes) => {

    const total = orderRes[0].total;

    // get address
    db.query("SELECT city FROM addresses WHERE id=?", [addressId], (err, addrRes) => {

      const city = addrRes[0].city;

      const shippingCost = shippingService.calculateShipping(total, city);

      const trackingNumber = "TRK" + Date.now();

      const sql = `
        INSERT INTO shipments 
        (order_id, address_id, tracking_number, carrier, shipping_cost, estimated_delivery)
        VALUES (?, ?, ?, 'DHL', ?, DATE_ADD(NOW(), INTERVAL 5 DAY))
      `;

      db.query(sql, [orderId, addressId, trackingNumber, shippingCost],
        () => res.json({
          msg: "Shipment created",
          trackingNumber,
          shippingCost
        })
      );
    });
  });
};



//  TRACK SHIPMENT
exports.trackShipment = (req, res) => {

  const trackingNumber = req.params.trackingNumber;

  const sql = `
    SELECT s.*, o.user_id 
    FROM shipments s
    JOIN orders o ON s.order_id = o.id
    WHERE s.tracking_number=?
  `;

  db.query(sql, [trackingNumber], (err, result) => {

    if (result.length === 0)
      return res.status(404).json({ msg: "Not found" });

    res.json(result[0]);
  });
};



//  UPDATE DELIVERY STATUS (ADMIN)
exports.updateStatus = (req, res) => {

  const { status } = req.body;

  db.query(
    "UPDATE shipments SET status=? WHERE id=?",
    [status, req.params.id],
    () => res.json({ msg: "Status updated" })
  );
};
