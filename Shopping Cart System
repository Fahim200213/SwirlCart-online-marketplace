1. CART CONTROLLER
controllers/cartController.js
const db = require("../db");


//  ADD TO CART
exports.addToCart = (req, res) => {
  const { productId, quantity } = req.body;
  const userId = req.user.id;

  const checkSql = `
    SELECT * FROM cart_items 
    WHERE user_id=? AND product_id=?
  `;

  db.query(checkSql, [userId, productId], (err, results) => {

    if (results.length > 0) {
      // already exists → update quantity
      const updateSql = `
        UPDATE cart_items 
        SET quantity = quantity + ? 
        WHERE user_id=? AND product_id=?
      `;

      db.query(updateSql, [quantity, userId, productId],
        () => res.json({ msg: "Quantity updated" })
      );

    } else {
      // new item
      const insertSql = `
        INSERT INTO cart_items (user_id, product_id, quantity)
        VALUES (?, ?, ?)
      `;

      db.query(insertSql, [userId, productId, quantity],
        () => res.json({ msg: "Added to cart" })
      );
    }
  });
};



//  REMOVE FROM CART
exports.removeFromCart = (req, res) => {
  const userId = req.user.id;
  const productId = req.params.productId;

  db.query(
    "DELETE FROM cart_items WHERE user_id=? AND product_id=?",
    [userId, productId],
    () => res.json({ msg: "Item removed" })
  );
};



//  UPDATE QUANTITY
exports.updateQuantity = (req, res) => {
  const userId = req.user.id;
  const { productId, quantity } = req.body;

  db.query(
    "UPDATE cart_items SET quantity=? WHERE user_id=? AND product_id=?",
    [quantity, userId, productId],
    () => res.json({ msg: "Quantity updated" })
  );
};



// GET CART +  TOTAL PRICE
exports.getCart = (req, res) => {
  const userId = req.user.id;

  const sql = `
    SELECT 
      c.product_id,
      p.name,
      p.price,
      c.quantity,
      (p.price * c.quantity) AS total
    FROM cart_items c
    JOIN products p ON c.product_id = p.id
    WHERE c.user_id=?
  `;

  db.query(sql, [userId], (err, results) => {

    let grandTotal = 0;
    results.forEach(item => {
      grandTotal += item.total;
    });

    res.json({
      items: results,
      totalPrice: grandTotal
    });
  });
};
 2. CART ROUTES
routes/cartRoutes.js
const router = require("express").Router();

const {
  addToCart,
  removeFromCart,
  updateQuantity,
  getCart
} = require("../controllers/cartController");

const auth = require("../middleware/authMiddleware");

// protected routes
router.post("/add", auth, addToCart);
router.delete("/:productId", auth, removeFromCart);
router.put("/update", auth, updateQuantity);
router.get("/", auth, getCart);

module.exports = router;
