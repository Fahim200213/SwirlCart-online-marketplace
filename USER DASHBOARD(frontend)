import { useEffect, useState } from "react";
import api from "../services/api";

export default function Dashboard() {

  const [orders, setOrders] = useState([]);

  useEffect(() => {
    api.get("/orders").then(res => setOrders(res.data));
  }, []);

  return (
    <div className="p-4">
      <h2>Your Orders</h2>

      {orders.map(o => (
        <div key={o.id}>
          Order #{o.id} - ${o.total} - {o.status}
        </div>
      ))}
    </div>
  );
}
